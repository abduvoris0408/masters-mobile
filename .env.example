EXPO_PUBLIC_API_URL=

EXPO_PUBLIC_YANDEX_MAPS_API_KEY=
EXPO_PUBLIC_YANDEX_GEOCODER_API_KEY=
# Android only — react-native-maps needs this for the Google Maps SDK.
# Get one at https://console.cloud.google.com (enable "Maps SDK for Android").
# iOS uses Apple Maps and needs no key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
